# HireFlow Backend Environment Configuration Template
# Copy this file to .env and configure your environment-specific credentials

PROJECT_NAME=HireFlow API
ENVIRONMENT=development
DEBUG=True

# Database (SQLite default or PostgreSQL connection string)
DATABASE_URL=sqlite:///./hireflow.db

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage
UPLOAD_DIR=./uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Email Service Configuration (Candidate Evaluation Reports)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM=noreply@hireflow.ai
EMAIL_FROM_NAME=HireFlow Recruitment Team

# Alternatively, if using an HTTP Email API Provider (Required for Render Free Tier which blocks port 587):
# Brevo (Sendinblue): Free 300 emails/day to ANY recipient over HTTPS port 443 (Get key at https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Resend API Key (https://resend.com)
EMAIL_API_KEY=
