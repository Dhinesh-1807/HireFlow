# HireFlow Backend Configuration

# Application
PROJECT_NAME=HireFlow API
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL recommended for production, SQLite supported for zero-setup local dev)
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/hireflow
# Example SQLite: sqlite:///./hireflow.db
DATABASE_URL=sqlite:///./hireflow.db

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# File Upload Storage
UPLOAD_DIR=./uploads

# CORS (Allowed origins for frontend, separated by comma)
# Defaults allow standard React / Vite development servers
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
